# ───────────────────────────────────────────────────────────
# СинтексПруф — пример переменных окружения.
# Скопируйте в .env.local (Next.js) и/или .env (docker compose).
# На Vercel задайте те же ключи в Project Settings → Environment Variables.
# ───────────────────────────────────────────────────────────

# PostgreSQL (Neon / Supabase / Vercel Postgres / локальный контейнер).
# Если переменная НЕ задана, используется встроенная PGlite (PostgreSQL в Wasm):
# данные в ./.pglite, миграции из ./drizzle применяются автоматически —
# для локальной разработки внешняя БД не нужна.
# На Vercel DATABASE_URL обязательна для персистентности: без неё PGlite
# живёт в /tmp и очищается при холодном старте функции.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/sinteksproof

# ── ИИ-провайдеры: укажите хотя бы один. Приоритет определяется AI_PROVIDER ──
# AI_PROVIDER=auto | gemini | gigachat | yandexgpt | heuristic
# auto = пробует российские (Gigachat → YandexGPT) → Gemini → heuristic
AI_PROVIDER=auto
AI_FALLBACK=true

# Gemini API — ключ из Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gigachat (Сбер) — https://developers.sber.ru/portal/products/gigachat
# Получите client credentials в проекте Gigachat API, scope = GIGACHAT_API_PERS
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# YandexGPT (Yandex Cloud) — https://yandex.cloud/ru/docs/foundation-models/
# Создайте сервисный аккаунт, получите API-ключ и ID каталога
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEXGPT_MODEL=yandexgpt

# FastAPI-раннер с Docker-песочницей.
# Если не задан — используется встроенный TypeScript-движок статического анализа.
SANDBOX_API_URL=
SANDBOX_API_TOKEN=

# GitHub API (импорт репозиториев). Без токена действуют публичные лимиты.
GITHUB_TOKEN=

# ── OAuth / Вход через Госуслуги, Яндекс, VK, MAX ──
# Базовый URL приложения (для callback). На Vercel авто-определяется из VERCEL_URL
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-random-32-chars

# Яндекс ID — https://oauth.yandex.ru (создайте приложение, укажите Callback #1 = {NEXTAUTH_URL}/api/auth/callback/yandex)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# VK ID — https://id.vk.com/about/business/go/docs (или classic https://vk.com/dev/access_token)
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# MAX (VK) — мессенджер MAX, OAuth-совместимый. Документация выдаётся после регистрации партнёра.
MAX_CLIENT_ID=
MAX_CLIENT_SECRET=
MAX_AUTHORIZE_URL=https://oauth.max.ru/authorize
MAX_TOKEN_URL=https://oauth.max.ru/token
MAX_USERINFO_URL=https://oauth.max.ru/userinfo

# Госуслуги / ЕСИА — https://esia.gosuslugi.ru/docs/ (требует ГОСТ-подпись в проде; для демо — упрощённый OAuth2)
GOSUSLUGI_CLIENT_ID=
GOSUSLUGI_CLIENT_SECRET=
GOSUSLUGI_AUTHORIZE_URL=https://esia.gosuslugi.ru/aas/oauth2/v3/authorize
GOSUSLUGI_TOKEN_URL=https://esia.gosuslugi.ru/aas/oauth2/v3/token
GOSUSLUGI_USERINFO_URL=https://esia.gosuslugi.ru/rs/prns/1

# CORS для FastAPI (список через запятую)
CORS_ORIGINS=*
